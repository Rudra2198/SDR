# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# ─── Database (Postgres + pgvector) ───────────────────────────────
# docker-compose reads POSTGRES_* ; the app reads DATABASE_URL.
POSTGRES_USER=ruvu
POSTGRES_PASSWORD=ruvu
POSTGRES_DB=ruvu_sdr
DATABASE_URL=postgresql://ruvu:ruvu@localhost:5432/ruvu_sdr

# ─── Langfuse (Plane 07 observability) — Cloud free tier ──────────
# Create a project at cloud.langfuse.com → Settings → API Keys.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ─── Anthropic (Plane 03 agents) — needed from Phase 2 ────────────
ANTHROPIC_API_KEY=

# ─── Tool credentials (wired in later phases) ─────────────────────
HUBSPOT_ACCESS_TOKEN=          # Phase 1 — HubSpot private-app token (read contacts/companies, write activity)
# CLAY_API_KEY=                # Phase 1
# CLAY_WEBHOOK_SECRET=         # Phase 1
# CALCOM_API_KEY=              # Phase 5
# Gmail uses OAuth (Phase 3) — credentials handled separately.
